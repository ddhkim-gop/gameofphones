<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nightly 11pm job (scripts/run_daily_scan.sh): (1) injury/gap/compilation
  detection via daily_scan.py, then (2) ESPN highlight seed for the week's real
  clips + rebuild + push. Runs from this Mac because ESPN's CDN 202-blocks
  datacenter IPs (so not from CI).

  Install / reload after editing:
    cp "scripts/com.gameofphones.daily-scan.plist" ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.gameofphones.daily-scan.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gameofphones.daily-scan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/david/Desktop/Skyler/personal/fantasy football/gameofphones/scripts/run_daily_scan.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>23</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/david/Desktop/Skyler/personal/fantasy football/gameofphones/scripts/.daily-scan.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/david/Desktop/Skyler/personal/fantasy football/gameofphones/scripts/.daily-scan.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
